{
  "name": "heejun",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "husky",
    "check:validators": "node --check scripts/validate-dev-guides.mjs && node --check scripts/validate-recommendation-templates.mjs",
    "validate:guides": "node scripts/validate-dev-guides.mjs",
    "validate:recommendations": "node scripts/validate-recommendation-templates.mjs",
    "verify": "pnpm run validate:architecture && pnpm run check:validators && pnpm run validate:guides && pnpm run validate:recommendations",
    "verify:push": "pnpm run verify",
    "ci": "pnpm run verify",
    "sonar": "sonar-scanner",
    "sonar:ci": "sonar-scanner -Dsonar.qualitygate.wait=true",
    "validate:architecture": "node scripts/validate-architecture.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "puppeteer": "^25.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
