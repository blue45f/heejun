{
  "name": "heejun",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "prepare": "husky",
    "check:validators": "node --check scripts/validate-dev-guides.mjs && node --check scripts/validate-recommendation-templates.mjs",
    "validate:guides": "node scripts/validate-dev-guides.mjs",
    "validate:recommendations": "node scripts/validate-recommendation-templates.mjs",
    "verify": "pnpm run validate:architecture && pnpm run check:validators && pnpm run validate:guides && pnpm run validate:recommendations && pnpm run build",
    "verify:push": "pnpm run verify",
    "ci": "pnpm run verify",
    "sonar": "sonar-scanner",
    "sonar:ci": "sonar-scanner -Dsonar.qualitygate.wait=true",
    "validate:architecture": "node scripts/validate-architecture.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.475.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "puppeteer": "^25.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
